# Banco e autenticação (Neon)
# Na Vercel, configure estas variáveis em Production e Preview.
# DATABASE_URL é a connection string do Postgres.
DATABASE_URL=
# ATENÇÃO: NEON_AUTH_BASE_URL deve ser uma URL HTTP(S) do Neon Auth.
# Nunca coloque DATABASE_URL/uma connection string postgres:// neste campo.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# E-mail usado somente para liberar automaticamente o primeiro administrador.
BOOTSTRAP_ADMIN_EMAIL=

# Fonte operacional dos veículos por link público somente leitura
# Preferência: link do Google Sheets com a aba correta selecionada, inclusive links com #gid=...
# A planilha precisa estar acessível para leitura sem login. O PintService converte o link para CSV e relê antes de responder status.
VEHICLE_DATA_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
REPUTATION_AI_DRAFTS_ENABLED=true

# WhatsApp Cloud API (Meta)
# Callback URL: https://SEU-DOMINIO/api/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# Instagram profissional (Instagram Login / Graph API)
# Callback URL: https://SEU-DOMINIO/api/instagram/webhook
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0
# messages = avisa toda DM + comentários críticos; all = tudo; critical = apenas alta/urgente.
INSTAGRAM_ALERT_MODE=messages

# Google Business Profile
GOOGLE_BUSINESS_ACCESS_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Reclame Aqui Data Hub / RA API
RECLAME_AQUI_API_KEY=
RECLAME_AQUI_COMPANY_ID=
RECLAME_AQUI_INTERVAL=180
# Preencher somente com os endpoints recebidos no contrato da RA API.
RECLAME_AQUI_COMPLAINTS_URL=
RECLAME_AQUI_REPLY_URL_TEMPLATE=
RECLAME_AQUI_REPLY_METHOD=POST
RECLAME_AQUI_REPLY_BODY_FIELD=message

# Alertas internos de reputação
ALERT_WHATSAPP_TO=
# Template aprovado com 1 variável no corpo. Exemplo: "Alerta PintService: {{1}}"
ALERT_WHATSAPP_TEMPLATE=
ALERT_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
REPUTATION_ALERT_WINDOW_MINUTES=1500
# Usado pelo cron diário /api/reputacao/check.
CRON_SECRET=

# Respostas reais externas. Mantenha false até validar leitura e resposta de cada canal.
REPUTATION_LIVE_WRITES_ENABLED=false

# Cadastro público da oficina
# Há valores públicos seguros como fallback no código; estas variáveis permitem substituir sem novo deploy de código.
OFICINA_NAME=Pint Services Car Center
OFICINA_PUBLIC_PHONE=
OFICINA_ADDRESS=
OFICINA_HOURS=
OFICINA_INSTAGRAM_HANDLE=
OFICINA_INSTAGRAM_URL=
OFICINA_GOOGLE_BUSINESS_URL=
OFICINA_LEGACY_SITE_URL=
OFICINA_RECLAME_AQUI_URL=

# App
# Em produção use a URL canônica, sem barra final. Ex.: https://app.exemplo.com
APP_BASE_URL=http://localhost:3000
