# Banco e autenticação (Neon)
# Na Vercel, configure estas quatro variáveis em Production e Preview.
# Os valores reais ficam somente na Vercel; este arquivo documenta apenas os nomes.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# E-mail usado somente para liberar automaticamente o primeiro administrador.
BOOTSTRAP_ADMIN_EMAIL=

# Fonte operacional dos veículos por link público somente leitura
# Preferência: link do Google Sheets com a aba "Dados Importados" selecionada.
# O PintService converte automaticamente links do Google Sheets para CSV e relê antes de responder status.
VEHICLE_DATA_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
REPUTATION_AI_DRAFTS_ENABLED=true

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# Instagram profissional (Instagram Login / Graph API)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0
# messages = avisa toda DM + comentários críticos; all = tudo; critical = apenas alta/urgente.
INSTAGRAM_ALERT_MODE=messages

# Google Business Profile
GOOGLE_BUSINESS_ACCESS_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Reclame Aqui Data Hub / RA API
RECLAME_AQUI_API_KEY=
RECLAME_AQUI_COMPANY_ID=
RECLAME_AQUI_INTERVAL=180
# Preencher somente com os endpoints recebidos no contrato da RA API.
RECLAME_AQUI_COMPLAINTS_URL=
RECLAME_AQUI_REPLY_URL_TEMPLATE=
RECLAME_AQUI_REPLY_METHOD=POST
RECLAME_AQUI_REPLY_BODY_FIELD=message

# Alertas internos de reputação
ALERT_WHATSAPP_TO=
# Template aprovado com 1 variável no corpo. Exemplo: "Alerta PintService: {{1}}"
ALERT_WHATSAPP_TEMPLATE=
ALERT_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
REPUTATION_ALERT_WINDOW_MINUTES=1500
CRON_SECRET=

# Respostas reais externas. Só ative depois de conectar as contas e testar.
REPUTATION_LIVE_WRITES_ENABLED=false

# Integração com a central Blinko
# Segredo compartilhado usado apenas no endpoint de resumo operacional.
# Gere um valor aleatório longo e configure o mesmo segredo no PintService e na Blinko.
BLINKO_API_SECRET=

# Oficina / equipe
OFICINA_NAME=Pint Services Car Center
OFICINA_PUBLIC_PHONE=+55 71 3508-7781
OFICINA_HOURS=segunda a quinta das 08h às 18h; sexta das 08h às 17h; sábado e domingo fechado
OFICINA_ADDRESS=R. Leonardo Rodrigues da Silva, 480 - Vilas do Atlântico, Lauro de Freitas - BA, 42700-000, Brasil
OFICINA_INSTAGRAM_HANDLE=@pintservicescarcenter
OFICINA_INSTAGRAM_URL=https://www.instagram.com/pintservicescarcenter/
OFICINA_GOOGLE_BUSINESS_URL=https://share.google/g4u3pkUYBNI0GKkVd
OFICINA_LEGACY_SITE_URL=https://pintservices.com.br/
OFICINA_RECLAME_AQUI_URL=https://www.reclameaqui.com.br/empresa/pint-services-reparos-automotivos/

# App
APP_BASE_URL=http://localhost:3000
