# Banco atual (opcional por enquanto - sem estas variáveis o painel usa modo demo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Manter false enquanto o login/RBAC não estiver ativo na produção principal.
REPUTATION_AI_DRAFTS_ENABLED=false

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# Instagram profissional (Instagram Login / Graph API)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0

# Google Business Profile
GOOGLE_BUSINESS_ACCESS_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Reclame Aqui Data Hub / RA API
RECLAME_AQUI_API_KEY=
RECLAME_AQUI_COMPANY_ID=
RECLAME_AQUI_INTERVAL=180
# Os campos abaixo só devem ser preenchidos com os endpoints recebidos no contrato da RA API.
RECLAME_AQUI_COMPLAINTS_URL=
RECLAME_AQUI_REPLY_URL_TEMPLATE=
RECLAME_AQUI_REPLY_METHOD=POST
RECLAME_AQUI_REPLY_BODY_FIELD=message

# Alertas internos de reputação
ALERT_WHATSAPP_TO=
REPUTATION_ALERT_WINDOW_MINUTES=1500
CRON_SECRET=

# Segurança das respostas externas
# Manter false enquanto /api/reputacao/reply não estiver protegido pelo login/RBAC em produção.
REPUTATION_LIVE_WRITES_ENABLED=false

# Oficina / equipe
OFICINA_HOURS=das 8h às 16h
OFICINA_ADDRESS=
STAFF_API_TOKEN=

# App
APP_BASE_URL=http://localhost:3000
